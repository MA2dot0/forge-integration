# Claude player for Forge
# Copy this file to "claude.properties" in Forge's user data folder
# (Windows: %APPDATA%\Forge, Linux/macOS: ~/.forge, Android: Forge's data folder)
# or next to the Forge executable. Then pick the AI profile "Claude" for an AI player in the lobby.
# Changes are picked up mid-game; no restart needed.

# Your Anthropic API key (or leave empty and set the ANTHROPIC_API_KEY environment variable)
api_key=

# Model to use
model=claude-sonnet-5-5

# Max tokens per answer; extended thinking budget (0 = off; e.g. 2000 = slower but stronger)
max_tokens=1024
thinking_budget=0

# Network
timeout_seconds=90
retries=3

# When to ask Claude while it holds priority:
#   smart = its own main phases, whenever something is on the stack, after blockers,
#           the opponent's declare-attackers and end steps (cheaper, recommended)
#   all   = every time it has priority and something is playable
priority_mode=smart

# Let Claude pick targets for its spells/abilities and for its triggered abilities
choose_targets=true
choose_trigger_targets=true

# Show Claude's short reasoning in the game log
show_reasoning=true

# Write every question and answer to claude-forge.log (next to this file)
log_to_file=true

# How many recent game-log lines to include with each question
log_lines=15

# Optional extra instructions, e.g. a play style
extra_instructions=

# ---- Help from the Forge AI ----
# Show the built-in AI's own choice as a second opinion at each decision
ai_suggestions=true
# Exact damage / lethal / block-outcome numbers computed by the engine
combat_math=true
# Simulate each candidate play on a copy of the game and show the score change
simulate=true
# 0 = just that play, 1 = that play plus the best follow-up play (slower)
sim_depth=1
# Time budget for simulations per decision, in milliseconds
sim_time_ms=2000

# ---- Memory ----
# Running notes Claude keeps during a game
notes=true
# Show the remaining contents of Claude's library (it knows its own decklist)
deck_info=true
# Use claude-lessons.txt (lessons from earlier games) in every game
lessons=true
# After each game, let Claude review its play and add lessons to claude-lessons.txt
review_after_game=true
# Model for the review (empty = same as model)
review_model=
# How many of the newest lessons to use
max_lessons=40

# ---- Scryfall ----
# Attach official rulings for the cards in each decision (fetched once, cached in claude-rulings-cache.json)
rulings=true
rulings_per_card=4
# Let Claude search Scryfall / look up a card mid-decision, at most max_lookups times per decision
scryfall_lookup=true
max_lookups=2
